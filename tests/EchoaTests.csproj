<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build and run: dotnet build -c Release, then run EchoaTests.exe. Never touches real settings. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EchoaTests</AssemblyName>
    <RootNamespace>Echoa</RootNamespace>
    <StartupObject>Echoa.Tests</StartupObject>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);CS0067;CS0169;CS0414;CS0649</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT' And Exists('/usr/lib/mono/4.8-api')">
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <FrameworkPathOverride>/usr/lib/mono/4.8-api</FrameworkPathOverride>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\src\*.cs" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
